; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Flashcard Heroes"
run/main_scene="uid://h4rso7xt5e6a"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"
#Windowsettingsconfig/window/size/viewport_width=1280
config/window/size/viewport_height=720
config/window/size/window_width_override=1280
config/window/size/window_height_override=720
config/window/stretch/mode="canvas_items"
config/window/stretch/aspect="keep"
config/window/stretch/scale=1.0

[autoload]

EventBus="*res://scripts/EventBus.gd"
GameManager="*res://scripts/GameManager.gd"
PlayerData="*res://scripts/PlayerData.gd"
UnitLibrary="*res://scripts/UnitLibrary.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="viewport"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
