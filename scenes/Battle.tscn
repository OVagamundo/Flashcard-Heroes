theme_override_constants/separation = 10

# Add 6 player unit slots
[node name="Player1" parent="VBoxContainer/PlayerArea/VBoxContainer/PlayerLineup" instance=ExtResource("2_placeholder_unit")]
layout_mode = 2

[node name="Player2" parent="VBoxContainer/PlayerArea/VBoxContainer/PlayerLineup" instance=ExtResource("2_placeholder_unit")]
