layout_mode = 2

[node name="Enemy5" parent="VBoxContainer/EnemyArea/MarginContainer/VBoxContainer/EnemyLineup" instance=ExtResource("2_placeholder_unit")]
layout_mode = 2

[node name="Enemy6" parent="VBoxContainer/EnemyArea/MarginContainer/VBoxContainer/EnemyLineup" instance=ExtResource("2_placeholder_unit")]
layout_mode = 2

# Enemy Trinkets
[node name="EnemyTrinketsLabel" type="Label" parent="VBoxContainer/EnemyArea/MarginContainer/VBoxContainer"]
layout_mode = 2
text = "Enemy Trinkets"
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(1, 1, 1, 1)

[node name="EnemyTrinkets" type="HBoxContainer" parent="VBoxContainer/EnemyArea/MarginContainer/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 60)
theme_override_constants/separation = 10

# Add 3 enemy trinket slots
[node name="EnemyTrinket1" parent="VBoxContainer/EnemyArea/MarginContainer/VBoxContainer/EnemyTrinkets" instance=ExtResource("3_placeholder_item")]
layout_mode = 2
custom_minimum_size = Vector2(40, 40)

[node name="EnemyTrinket2" parent="VBoxContainer/EnemyArea/MarginContainer/VBoxContainer/EnemyTrinkets" instance=ExtResource("3_placeholder_item")]
layout_mode = 2
custom_minimum_size = Vector2(40, 40)

[node name="EnemyTrinket3" parent="VBoxContainer/EnemyArea/MarginContainer/VBoxContainer/EnemyTrinkets" instance=ExtResource("3_placeholder_item")]
layout_mode = 2
custom_minimum_size = Vector2(40, 40)

# Player Area
[node name="PlayerArea" type="PanelContainer" parent="VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="VBoxContainer" type="VBoxContainer" parent="VBoxContainer/PlayerArea"]
layout_mode = 2
anchor_right = 1.0
anchor_bottom = 1.0

[node name="PlayerLineupLabel" type="Label" parent="VBoxContainer/PlayerArea/VBoxContainer"]
layout_mode = 2
text = "Your Lineup"
theme_override_font_sizes/font_size = 16

[node name="PlayerLineup" type="HBoxContainer" parent="VBoxContainer/PlayerArea/VBoxContainer"]
layout_mode = 2
