[node name="Player6" parent="VBoxContainer/PlayerArea/VBoxContainer/PlayerLineup" instance=ExtResource("2_placeholder_unit")]
layout_mode = 2

# Player Bench and Inventory
[node name="BenchAndInventory" type="HBoxContainer" parent="VBoxContainer/PlayerArea/VBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 1
theme_override_constants/separation = 20

# Player Bench
[node name="BenchContainer" type="VBoxContainer" parent="VBoxContainer/PlayerArea/VBoxContainer/BenchAndInventory"]
layout_mode = 2
size_flags_horizontal = 1
size_flags_vertical = 3

