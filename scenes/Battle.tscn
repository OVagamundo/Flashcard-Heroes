theme_override_font_sizes/font_size = 14

[node name="Bench" type="HBoxContainer" parent="VBoxContainer/PlayerArea/VBoxContainer/BenchAndInventory/BenchContainer"]
layout_mode = 2
custom_minimum_size = Vector2(0, 80)
theme_override_constants/separation = 10

# Add 3 bench slots
[node name="Bench1" parent="VBoxContainer/PlayerArea/VBoxContainer/BenchAndInventory/BenchContainer/Bench" instance=ExtResource("2_placeholder_unit")]
layout_mode = 2

[node name="Bench2" parent="VBoxContainer/PlayerArea/VBoxContainer/BenchAndInventory/BenchContainer/Bench" instance=ExtResource("2_placeholder_unit")]
