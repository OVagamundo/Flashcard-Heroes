msgid "item_t2_c.name"
msgstr "Elixir da Fênix"

msgid "item_t2_c.desc"
msgstr "Ao ser ferido POR UM ATAQUE, cura esta unidade em 1 HP e ganha 1 PWR."

msgid "ability.basic_attack.desc"
msgstr "Causa (PWR) de dano ao inimigo da frente."

msgid "ability.basic_attack_ranged_mirror.desc"
msgstr "Causa (PWR) de dano ao inimigo no espaço espelhado."

msgid "ability.item_tier1b_extra_attack.desc"
msgstr "Ao atacar, se o alvo tiver mais HP que o portador, realiza um ataque extra."

