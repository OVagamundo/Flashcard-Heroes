msgstr "Novato"

msgid "trait.plant.2"
msgstr "Ao apertar Pronto, a Planta mais à frente ganha 1 de Espinhos."

msgid "trait.plant.3"
msgstr "No início de cada turno, a Planta com menor Vida cura 1 de Vida."

msgid "trait.plant.4"
msgstr "Ao apertar Pronto, todas as Plantas ganham 1 de Espinhos e +1 de Vida. A Planta mais à frente ganha um total de 2 de Espinhos."

msgid "trait.plant.5"
