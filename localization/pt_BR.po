msgid "trait.tank.4"
msgstr "No início de cada turno, o Guardião mais à frente ganha 1 de Armadura. Guardiões interceptam ataques direcionados ao aliado diretamente atrás deles."

msgid "trait.tank.5"
msgstr "Sempre que um Guardião ganha Armadura de qualquer fonte, ganha a mesma quantidade de Espinhos."

msgid "trait.tank.name"
msgstr "Guardião"

msgid "trait.toy.2"
