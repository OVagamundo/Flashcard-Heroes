msgstr "Insígnia do Veterano"

msgid "trinket.veteran_insignia.desc"
msgstr "Quando uma unidade de Nível 2 entra em campo, ela recebe +1 HP e +1 PWR."

msgid "ability.veteran_insignia.desc"
msgstr "Quando uma unidade de Nível 2 entra em campo, ela recebe +1 HP e +1 PWR."

