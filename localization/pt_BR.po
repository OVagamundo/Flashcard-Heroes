msgid "unit_dust_elite_t1.desc"
msgstr "No final do turno, invoca unidades para preencher espaços vazios. Invoca um Recruta de Poeira T1 quando um aliado morre. Ganha HP e PWR com base no tier de qualquer unidade de Poeira que morra (ex: +1/+1 para T1, +2/+2 para T2). Invoca um Recruta de Poeira no início do turno. Invoca um Recruta de Poeira ao atacar."

msgid "unit_dust_elite_t1.name"
msgstr "Guarda de Poeira (T1)"

msgid "unit_dust_elite_t2.desc"
msgstr "No final do turno, invoca unidades para preencher espaços vazios. Invoca um Recruta de Poeira T1 ou T2 aleatório quando um aliado morre. Ganha HP e PWR com base no tier de qualquer unidade de Poeira que morra (ex: +1/+1 para T1, +2/+2 para T2). Invoca um Recruta de Poeira no inventário do jogador."

msgid "unit_dust_elite_t2.name"
msgstr "Sentinela de Poeira (T2)"

msgid "unit_dust_elite_t3.desc"
msgstr "No final do turno, invoca unidades para preencher espaços vazios. Invoca um Recruta de Poeira T1, T2 ou T3 aleatório quando um aliado morre. Ganha HP e PWR com base no tier de qualquer unidade de Poeira que morra (ex: +1/+1 para T1, +2/+2 para T2)."

msgid "unit_dust_elite_t3.name"
msgstr "Soberano de Poeira (T3)"

