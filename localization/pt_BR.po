msgid "trait.toy.3"
msgstr "Inimigos que atingem um Brinquedo com ataque corpo a corpo recebem 3 de Estática."

msgid "trait.toy.4"
msgstr "Inimigos que atingem um Brinquedo com ataque corpo a corpo recebem 4 de Estática."

msgid "trait.toy.5"
