msgid "GLOSSARY_ATTACK_OVERRIDE"
msgstr "Substituição de Ataque"

msgid "GLOSSARY_ATTACK_OVERRIDE_DESC"
msgstr "Substitui o ataque básico padrão por uma habilidade especializada ou padrão de dano."

msgid "GLOSSARY_BOUNCE"
msgstr "Ricochete"

msgid "GLOSSARY_BOUNCE_DESC"
msgstr "Atinge o alvo principal e salta para inimigos aleatórios adicionais, reduzindo o dano ou acúmulos pela metade a cada salto."

msgid "GLOSSARY_EMPOWERED_ATTACK"
msgstr "Ataque Fortalecido"

msgid "GLOSSARY_EMPOWERED_ATTACK_DESC"
msgstr "Uma ação de ataque aprimorada que se consome ao ser executada para causar Dano Bônus ou aplicar Efeitos ao alvo."

msgid "GLOSSARY_EXTRA_ACTION"
msgstr "Ação Extra"

msgid "GLOSSARY_EXTRA_ACTION_DESC"
msgstr "Age novamente de imediato com uma ação de turno completa, reavaliando todas as habilidades (uma vez por turno)."

msgid "GLOSSARY_EXTRA_ATTACK"
msgstr "Ataque Extra"

msgid "GLOSSARY_EXTRA_ATTACK_DESC"
msgstr "Realiza uma ação de ataque adicional imediata durante este turno (uma vez por turno)."

msgid "GLOSSARY_INTERCEPT"
msgstr "Interceptar"

msgid "GLOSSARY_INTERCEPT_DESC"
msgstr "Salta à frente de um aliado para absorver um ataque no lugar dele."

msgid "GLOSSARY_LIFESTEAL"
msgstr "Roubo de Vida"

msgid "GLOSSARY_LIFESTEAL_DESC"
msgstr "Cura o atacante em uma porcentagem do dano real causado à Vida do alvo."

msgid "GLOSSARY_MELEE"
msgstr "Ataque Corpo a Corpo"

msgid "GLOSSARY_MELEE_DESC"
msgstr "Golpeia o inimigo mais à frente. Mitigado por ARMADURA; ativa os ESPINHOS do defensor."

msgid "GLOSSARY_RANGED"
msgstr "Ataque à Distância"

msgid "GLOSSARY_RANGED_DESC"
msgstr "Golpeia o inimigo na posição espelhada. Se o espaço estiver vazio, atinge o inimigo mais atrás. Mitigado por ARMADURA; ignora os ESPINHOS do defensor."

msgid "GLOSSARY_SHOCKWAVE"
msgstr "Onda de Choque"

msgid "GLOSSARY_SHOCKWAVE_DESC"
msgstr "Atinge o alvo principal e espalha dano para até 2 posições atrás com 50% de redução por posição."

msgid "STATUS_ARMOR"
msgstr "Armadura"

msgid "STATUS_ARMOR_DESC"
msgstr "Armadura: Absorve uma quantidade de dano igual ao valor de Armadura. Desaparece ao final do turno."

msgid "STATUS_BOUNTY"
msgstr "Recompensa"

msgid "STATUS_BOUNTY_DESC"
msgstr "Quando esta unidade é derrotada por qualquer meio, concede 1 de Ouro. Permanece até a unidade morrer ou a batalha terminar."

msgid "STATUS_BURN"
msgstr "Chamas"

msgid "STATUS_BURN_DESC"
msgstr "Causa dano igual ao valor de Chamas ao final do turno. Após o dano o valor cai pela metade."

msgid "STATUS_REINFORCE"
msgstr "Reforço"

