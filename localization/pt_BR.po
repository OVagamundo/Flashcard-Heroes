msgid "ability.item_tier3d_retaliate.desc"
msgstr "Ao ser ferido POR UM ATAQUE, causa metade do PWR do portador como dano a um inimigo aleatório."

msgid "ability.unit_tier3d_resilient_aura.desc"
msgstr "Ao ser ferido POR UM ATAQUE, concede +1 HP e +1 PWR aos aliados adjacentes."

msgid "item_t2_a.name"
msgstr "Pergaminho de Invocação"

msgid "item_t2_a.desc"
msgstr "Quando o portador morre, invoque uma unidade de Tier 1."

msgid "item_t3_e.name"
msgstr "Barganha da Morte"

msgid "item_t3_e.desc"
msgstr "Quando o portador morre causa dano igual à metade do HP do inimigo com mais HP."

msgid "item_t3_f.name"
msgstr "Sifão de Almas"

msgid "item_t3_f.desc"
msgstr "Após causar dano rouba metade do PWR do alvo (mín. 1)."

msgid "item_t3_g.name"
msgstr "Mira de Precisão"

msgid "item_t3_g.desc"
msgstr "Ataques básicos têm como alvo o inimigo no espaço espelhado."

msgid "ability.item_t3f_power_drain.desc"
msgstr "Após causar dano rouba metade do PWR do alvo (mín. 1)."

msgid "ability.item_t3e_death_damage.desc"
msgstr "Quando o portador morre causa dano igual à metade do HP do inimigo com mais HP."

msgid "ability.item_t2_c_summon.desc"
msgstr "Quando o portador morre, invoca uma unidade Nível 1 aleatória no lugar."

msgid "ability.unit_tier2a_defensive_stance.desc"
msgstr "Ao ser alvo de um ataque, cura [2 / 4 / 6] HP antes de receber dano."

msgid "ability.unit_tier2b_shockwave.desc"
msgstr "O ataque causa dano em cascata: [100% / 150% / 200%] à frente, 50% à unidade atrás, 25% à próxima."

msgid "item_t2_b.name"
msgstr "Lâmina Sanguinária"

msgid "item_t2_b.desc"
msgstr "Quando o portador derrota um inimigo, ele age novamente imediatamente (uma vez por turno)."

msgid "ability.item_tier2b_bloodlust.desc"
msgstr "Quando o portador derrota um inimigo, ele age novamente imediatamente (uma vez por turno)."

msgid "hero_timekeeper.name"
msgstr "Guardião do Tempo"

msgid "hero_timekeeper.desc"
msgstr "Minijogo: +1s ao acertar, -0,5s ao errar. Ganha 5 fichas por turno em Batalhas e Locais de Descanso. No início de cada turno, concede +2 HP às unidades à frente e +2 PWR às unidades atrás."

msgid "ability.hero_timekeeper_gold_on_kill.desc"
msgstr "Ganha 1 ouro quando este herói mata um inimigo."

msgid "ability.hero_timekeeper_time_warp.desc"
msgstr "Minigame: +1s correto, -0.5s errado. Ganha 5 fichas por turno em Batalhas e Locais de Descanso."

msgid "ability.hero_timekeeper_temporal_aura.desc"
msgstr "No início de cada turno, concede +2 HP às unidades na frente e +2 PWR às unidades atrás."

msgid "boss_1.name"
msgstr "O Guardião Desperto"

msgid "boss_1.desc"
msgstr "No final do turno, invoca unidades para preencher espaços vazios. Toda vez que você saca um gachaball, este chefe ganha +1 HP."

msgid "boss_2.name"
msgstr "O Guardião das Sombras"

msgid "boss_2.desc"
