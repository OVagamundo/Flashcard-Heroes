msgstr "PWR"

msgid "deck.katakana.desc"
msgstr "Aprenda o silabário japonês angular usado para palavras estrangeiras e empréstimos."

msgid "deck.hiragana.desc"
msgstr "Domine o silabário japonês fluido para palavras nativas e gramática."

msgid "deck.kanji_100.desc"
msgstr "Desafie-se com 100 caracteres chineses essenciais usados na escrita japonesa."

msgid "deck.german_100.desc"
msgstr "Construa seu vocabulário alemão com 100 palavras comuns e essenciais."

msgid "deck.portuguese_100.desc"
msgstr "Expanda seu vocabulário português com 100 palavras essenciais do dia a dia."

msgid "deck.korean_hangul.desc"
msgstr "Aprenda o alfabeto coreano Hangul e as regras de pronúncia"

msgid "ability.unit_tier3e_ambush_predator.desc"
msgstr "Quando uma unidade inimiga é invocada, ataca-a causando [50% / 75% / 100%] do PWR desta unidade."

msgid "ability.unit_tier3f_summon_blessing.desc"
msgstr "Quando uma unidade aliada é invocada, concede [+3 / +5 / +7] HP."

msgid "STATUS_BURN"
msgstr "Chamas"

msgid "STATUS_BURN_DESC"
msgstr "Causa dano igual ao valor de Chamas ao final do turno. Após o dano o valor cai pela metade."

msgid "STATUS_ARMOR"
msgstr "Armadura"

msgid "STATUS_ARMOR_DESC"
msgstr "Armadura: Absorve uma quantidade de dano igual ao valor de Armadura. Desaparece ao final do turno."

msgid "STATUS_SPIKES"
msgstr "Espinhos"

msgid "STATUS_SPIKES_DESC"
msgstr "Espinhos: Devolve dano ao atacante igual ao valor de Espinhos. Perde 1 de Espinhos a cada ativação."

msgid "STATUS_STATIC"
msgstr "Estático"

msgid "STATUS_STATIC_DESC"
msgstr "Quando esta unidade morre, causa dano colateral igual aos seus acúmulos de Estática a aliados adjacentes vivos na formação, mitigado por Armadura. Acúmulos decaem em 1 no fim de cada turno."

msgid "trinket.novice_insignia.name"
msgstr "Insígnia do Novato"

msgid "trinket.novice_insignia.desc"
msgstr "Quando uma unidade de Nível 1 entra em campo, ela recebe +1 HP e +1 PWR."

msgid "ability.novice_insignia.desc"
msgstr "Quando uma unidade de Nível 1 entra em campo, ela recebe +1 HP e +1 PWR."

