msgid "trinket.vengeance.desc"
msgstr "Quando um aliado morre, concede +1 HP e +1 PWR a um aliado aleatório."

msgid "trinket.vengeance.name"
msgstr "Amuleto de Vingança"

msgid "trinket.veteran_insignia.desc"
msgstr "Quando uma unidade de Nível 2 entra em campo, ela recebe +1 HP e +1 PWR."

msgid "trinket.veteran_insignia.name"
msgstr "Insígnia do Veterano"

msgid "trinket.wanted_poster.desc"
msgstr "No início do turno, marca um inimigo aleatório desmarcado com Recompensa."

msgid "trinket.wanted_poster.name"
msgstr "Cartaz de Procurado"

msgid "trinket.water_insignia.desc"
msgstr "Quando uma unidade com o traço Água entra em campo, ela recebe +1 HP e +1 PWR."

msgid "trinket.water_insignia.name"
