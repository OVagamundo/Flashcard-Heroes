msgid "ability.unit_tier3a_mirror_strike.desc"
msgstr "Ataca o inimigo na posição oposta, causando [100% / 150% / 200%] de dano. Se vazio, ataca o inimigo do fundo."

msgid "ability.unit_tier3b_guardian_sacrifice.desc"
msgstr "Quando um aliado receberia dano letal, intercepta e recebe [100% / 75% / 50%] do dano no lugar."

msgid "ability.unit_tier3c_soul_summon.desc"
