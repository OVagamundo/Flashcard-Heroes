msgid "hero.name"
msgstr "Caçador de Recompensas"

msgid "hero.desc"
msgstr "Um caçador habilidoso que lucra com cada morte e fica mais forte com perdas. Ganha ouro por cada inimigo morto, e ganha +1 HP e +1 PWR quando aliados morrem."

msgid "enemy_hero.name"
msgstr "Herói Inimigo"

msgid "enemy_hero.desc"
msgstr "O campeão do inimigo."

msgid "ability.unit_t2_d_power.name"
msgstr "Poder das Fichas"

msgid "ability.unit_t2_d_power_l1.desc"
msgstr "Ganha PWR adicional igual a 100% das Fichas atuais, atualizando conforme as Fichas mudam."

msgid "ability.unit_t2_d_power_l2.desc"
msgstr "Ganha PWR adicional igual a 150% das Fichas atuais, atualizando conforme as Fichas mudam."

msgid "ability.unit_t2_d_power_l3.desc"
msgstr "Ganha PWR adicional igual a 200% das Fichas atuais, atualizando conforme as Fichas mudam."

msgid "ability.unit_t2_f_gold_pwr.name"
msgstr "Investimentos em Ouro"

msgid "ability.unit_t2_f_gold_pwr_l1.desc"
msgstr "O PWR inicial é igual ao seu Ouro atual multiplicado por 50% ao ser comprado ou gerado."

msgid "ability.unit_t2_f_gold_pwr_l2.desc"
msgstr "O PWR inicial é igual ao seu Ouro atual multiplicado por 100% ao ser comprado ou gerado."

msgid "ability.unit_t2_f_gold_pwr_l3.desc"
msgstr "O PWR inicial é igual ao seu Ouro atual multiplicado por 150% ao ser comprado ou gerado."

msgid "ability.unit_t1_c_ally_shield.name"
msgstr "Graça do Guardião"

msgid "ability.unit_t1_c_ally_shield.desc"
msgstr "Quando o aliado diretamente à frente recebe dano, cura-o por 1 HP."

msgid "ability.unit_t1_c_ally_shield_l2.desc"
msgstr "Quando o aliado diretamente à frente recebe dano, cura-o por 2 HP."

msgid "ability.unit_t1_c_ally_shield_l3.desc"
msgstr "Quando o aliado diretamente à frente recebe dano, cura-o por 3 HP."

msgid "ability.unit_t1_d_empathic_link.name"
msgstr "Vínculo Empático"

msgid "ability.unit_t1_d_empathic_link.desc"
msgstr "Quando esta unidade morre, concede seu PWR atual ao aliado atrás."

msgid "ability.unit_t1_d_empathic_link_l2.desc"
msgstr "Quando esta unidade morre, concede seu PWR atual ao aliado atrás, e metade disso ao próximo aliado."

msgid "ability.unit_t1_d_empathic_link_l3.desc"
msgstr "Quando esta unidade morre, concede seu PWR atual ao aliado atrás, metade ao próximo, e metade ao próximo."

msgid "ability.unit_tier1a_passive_heal.name"
msgstr "Resiliência"

msgid "ability.unit_tier1a_passive_heal.desc"
msgstr "Quando ferida POR UM ATAQUE, cura esta unidade em 1 de HP."

msgid "ability.unit_tier1a_passive_heal_l2.desc"
msgstr "Quando ferida POR UM ATAQUE, cura esta unidade em 2 de HP."

msgid "ability.unit_tier1a_passive_heal_l3.desc"
msgstr "Quando ferida POR UM ATAQUE, cura esta unidade em 3 de HP."

msgid "ability.unit_tier1b_counter_on_hurt.name"
msgstr "Retaliação"

msgid "ability.unit_tier1b_counter_on_hurt.desc"
msgstr "Quando ferido POR UM ATAQUE, dispara um projétil no atacante causando dano igual ao PWR. Ativa mesmo se letal."

msgid "ability.unit_tier1b_counter_on_hurt_l2.desc"
msgstr "Quando ferido POR UM ATAQUE, dispara um projétil no atacante causando dano igual ao PWR. O projétil então rebate para outro inimigo aleatório, causando metade do dano."

msgid "ability.unit_tier1b_counter_on_hurt_l3.desc"
msgstr "Quando ferido POR UM ATAQUE, dispara um projétil no atacante causando dano igual ao PWR. O projétil então rebate para 2 inimigos aleatórios, causando metade do dano por salto."

msgid "item_t1_a.name"
msgstr "Bênção da Carpa"

msgid "item_t1_a.desc"
msgstr "Um remédio suave infundido com o espírito da carpa."

msgid "item_t1_b.name"
msgstr "Espírito do Tigre"

msgid "item_t1_b.desc"
msgstr "Um elixir feroz que desperta a força interior."

msgid "item_t2_c.name"
msgstr "Elixir da Fênix"

msgid "item_t2_c.desc"
msgstr "Uma poção restauradora que renova corpo e espírito."

msgid "ability.basic_attack.name"
msgstr "Ataque Básico"

msgid "ability.basic_attack.desc"
msgstr "Causa (PWR) de dano ao inimigo da frente."

msgid "ability.basic_attack_ranged_mirror.name"
msgstr "Ataque Básico"

msgid "ability.basic_attack_ranged_mirror.desc"
msgstr "Causa (PWR) de dano ao inimigo no espaço espelhado."

msgid "ability.item_tier1b_extra_attack.name"
msgstr "Ataque Extra"

msgid "ability.item_tier1b_extra_attack.desc"
msgstr "Ao atacar, se o alvo tiver mais HP que o portador, realiza um ataque extra."

msgid "item.effect.hp"
msgstr "Adiciona (HP) HP à unidade."

msgid "item.effect.pwr"
msgstr "Adiciona (PWR) PWR à unidade."

msgid "item.effect.both"
msgstr "Adiciona (HP) HP e (PWR) PWR à unidade."

msgid "trinket.polished_plate.name"
msgstr "Placa Polida"

msgid "trinket.polished_plate.desc"
msgstr "Uma peça de armadura perfeitamente polida."

msgid "ability.polished_plate.name"
msgstr "Armadura Reforçada"

msgid "ability.polished_plate.desc"
msgstr "No início do turno, ganha 2 de Armadura."

msgid "options.audio.master"
msgstr "Volume Geral"

msgid "options.audio.music"
msgstr "Volume da Música"

msgid "options.audio.sfx"
msgstr "Volume de Efeitos"

msgid "options.language"
msgstr "Idioma"

msgid "options.reset_data"
msgstr "Resetar Progresso"

msgid "tutorial.btn.next"
msgstr "Próximo"

msgid "tutorial.btn.got_it"
msgstr "Entendi!"

msgid "battle.speed.label"
msgstr "Velocidade:"

msgid "ability.item_tier2c_passive_heal.name"
msgstr "Regeneração"

msgid "ability.item_tier2c_passive_heal.desc"
msgstr "Ao ser ferido POR UM ATAQUE, cura esta unidade em 1 HP e ganha 1 PWR."

msgid "ability.item_tier1a_turn_start_heal.name"
msgstr "Restauração"

msgid "ability.item_tier1a_turn_start_heal.desc"
msgstr "No início do turno, cura o portador em 2 HP."

msgid "ability.unit_tier2c_ally_death_buff.name"
msgstr "Impulso de Moral"

msgid "ability.unit_tier2c_ally_death_buff_l1.desc"
msgstr "Quando um aliado é derrotado, ganha +1 de HP e +1 de PWR."

msgid "ability.unit_tier2c_ally_death_buff_l2.desc"
msgstr "Quando um aliado é derrotado, ganha +2 de HP e +1 de PWR."

msgid "ability.unit_tier2c_ally_death_buff_l3.desc"
msgstr "Quando um aliado é derrotado, ganha +2 de HP e +2 de PWR."

msgid "ability.hero_bounty_hunter_ally_death_buff.name"
msgstr "Determinação do Saqueador"

msgid "ability.hero_bounty_hunter_ally_death_buff.desc"
msgstr "Quando um aliado é derrotado, ganha +1 HP e +1 PWR."

msgid "ability.item_tier3d_retaliate.name"
msgstr "Retaliação"

msgid "ability.item_tier3d_retaliate.desc"
msgstr "Ao ser ferido POR UM ATAQUE, causa metade do PWR do portador como dano a um inimigo aleatório."

msgid "ability.unit_tier3d_resilient_aura.name"
msgstr "Aura Resiliente"

msgid "ability.unit_tier3d_resilient_aura.desc"
msgstr "Ao ser ferido POR UM ATAQUE, concede +1 HP e +1 PWR aos aliados adjacentes."

msgid "item_t2_a.name"
msgstr "Pergaminho de Invocação"

msgid "item_t2_a.desc"
msgstr "Um pergaminho contendo um feitiço de invocação."

msgid "item_t3_e.name"
msgstr "Barganha da Morte"

msgid "item_t3_e.desc"
msgstr "Uma barganha amaldiçoada com a morte."

msgid "item_t3_f.name"
msgstr "Sifão de Almas"

msgid "item_t3_f.desc"
msgstr "Um sifão sombrio de almas."

msgid "item_t3_g.name"
msgstr "Mira de Precisão"

msgid "item_t3_g.desc"
msgstr "Uma mira para precisão extrema."

msgid "ability.item_t3e_death_damage.name"
msgstr "Golpe Final"

msgid "ability.item_t3f_power_drain.name"
msgstr "Dreno de Poder"

msgid "ability.item_t3f_power_drain.desc"
msgstr "Após causar dano rouba metade do PWR do alvo (mín. 1)."

msgid "ability.item_t3e_death_damage.desc"
msgstr "Quando o portador morre causa dano igual à metade do HP do inimigo com mais HP."

msgid "ability.item_t2_c_summon.name"
msgstr "Invocação"

msgid "ability.item_t2_c_summon.desc"
msgstr "Quando o portador morre, invoca uma unidade Nível 1 aleatória no lugar."

msgid "ability.unit_tier2a_defensive_stance.name"
msgstr "Postura Defensiva"

msgid "ability.unit_tier2a_defensive_stance.desc"
msgstr "Ao ser alvo de um ataque, cura [2 / 4 / 6] HP antes de receber dano."

msgid "ability.unit_tier2b_shockwave.name"
msgstr "Onda de Choque"

msgid "ability.unit_tier2b_shockwave.desc"
msgstr "O ataque causa dano em cascata: [100% / 150% / 200%] à frente, 50% à unidade atrás, 25% à próxima."

msgid "item_t2_b.name"
msgstr "Lâmina Sanguinária"

msgid "item_t2_b.desc"
msgstr "Uma lâmina sedenta por sangue."

msgid "ability.item_tier2b_bloodlust.name"
msgstr "Sede de Sangue"

msgid "ability.item_tier2b_bloodlust.desc"
msgstr "Quando o portador derrota um inimigo, ele age novamente imediatamente."

msgid "hero_timekeeper.name"
msgstr "Guardião do Tempo"

msgid "hero_timekeeper.desc"
msgstr "Um mago estudioso que concede +2 HP às unidades da frente e +2 PWR às unidades de trás no início do turno. Domina o tempo para estender o cronômetro do minigame."

msgid "ability.hero_timekeeper_gold_on_kill.name"
msgstr "Caçador de Recompensas"

msgid "ability.hero_timekeeper_gold_on_kill.desc"
msgstr "Ganha 1 ouro quando este herói mata um inimigo."

msgid "ability.hero_timekeeper_time_warp.name"
msgstr "Distorção Temporal"

msgid "ability.hero_timekeeper_time_warp.desc"
msgstr "Minigame: +1s correto, -0.5s errado. Ganha 5 fichas por turno em Batalhas e Locais de Descanso."

msgid "ability.hero_timekeeper_temporal_aura.name"
msgstr "Aura Temporal"

msgid "ability.hero_timekeeper_temporal_aura.desc"
msgstr "No início de cada turno, concede +2 HP às unidades na frente e +2 PWR às unidades atrás."

msgid "boss_1.name"
msgstr "O Guardião Desperto"

msgid "boss_1.desc"
msgstr "Um guardião poderoso que invoca aliados e fica mais forte conforme você saca das máquinas gacha."

msgid "boss_2.name"
msgstr "O Guardião das Sombras"

msgid "boss_2.desc"
msgstr "Drena poder de cada ficha que você gasta. Convoca criaturas das sombras para lutar ao seu lado."

msgid "boss_3.name"
msgstr "O Arauto da Tempestade"

msgid "boss_3.desc"
msgstr "Fica mais forte conforme aliados caem ao seu redor. Comanda reforços para suas fileiras."

msgid "boss_4.name"
msgstr "O Titã Ancestral"

msgid "boss_4.desc"
msgstr "Um ser ancestral que invoca guerreiros de eras passadas."

msgid "boss_5.name"
msgstr "O Árbitro Final"

msgid "boss_5.desc"
msgstr "O desafio final. Derrote-o para completar sua jogatina."

msgid "ability.boss_summon.name"
msgstr "Chamar Reforços"

msgid "ability.boss_summon.desc"
msgstr "No final do turno, invoca unidades para preencher espaços vazios."

msgid "ability.boss_1_draw_drain.name"
msgstr "Presença Drenante"

msgid "ability.boss_1_draw_drain.desc"
msgstr "Toda vez que você saca um gachaball, este chefe ganha +1 HP."

msgid "ability.boss_2_token_drain.name"
msgstr "Fome de Fichas"

msgid "ability.boss_2_token_drain.desc"
msgstr "Toda vez que você gasta uma ficha, este chefe ganha +1 HP."

msgid "ability.boss_3_ally_growth.name"
msgstr "Crescimento Vingativo"

msgid "ability.boss_3_ally_growth.desc"
msgstr "Quando um aliado é derrotado, ganha +1 HP e +1 PWR."

msgid "trinket.soul_echo.name"
msgstr "Eco da Alma"

msgid "trinket.soul_echo.desc"
msgstr "Uma gema mística que ecoa as almas dos caídos."

msgid "ability.soul_echo.name"
msgstr "Eco da Alma"

msgid "ability.soul_echo.desc"
msgstr "Quando um aliado morre, ressuscita a primeira unidade não-herói que morreu neste turno."

msgid "trinket.vengeance.name"
msgstr "Amuleto de Vingança"

msgid "trinket.vengeance.desc"
msgstr "Canaliza a fúria dos aliados caídos."

msgid "ability.vengeance.name"
msgstr "Vingança"

msgid "ability.vengeance.desc"
msgstr "Quando um aliado morre, concede +1 HP e +1 PWR a um aliado aleatório."

msgid "trinket.aegis.name"
msgstr "Amuleto Égide"

msgid "trinket.aegis.desc"
msgstr "Um amuleto protetor que escuda aliados de golpes fatais."

msgid "ability.aegis.name"
msgstr "Último Suspiro"

msgid "ability.aegis.desc"
msgstr "Uma vez por turno: Quando um aliado iria morrer, ele sobrevive com 1 HP."

msgid "trinket.twin_charm.name"
msgstr "Amuleto Gêmeo"

msgid "trinket.twin_charm.desc"
msgstr "Um amuleto espelhado que reflete os seus arredores."

msgid "ability.twin_charm_scale.name"
msgstr "Reflexo Compartilhado"

msgid "ability.twin_charm_scale.desc"
msgstr "Suas unidades ganham +1 de PWR para cada 2 cópias dessa mesma unidade no seu conjunto de batalha."

msgid "ability.unit_tier3a_mirror_strike.name"
msgstr "Ataque Espelhado"

msgid "ability.unit_tier3a_mirror_strike.desc"
msgstr "Ataca o inimigo na posição oposta, causando [100% / 150% / 200%] de dano. Se vazio, ataca o inimigo do fundo."

msgid "ability.unit_tier3b_guardian_sacrifice.name"
msgstr "Sacrifício do Guardião"

msgid "ability.unit_tier3b_guardian_sacrifice.desc"
msgstr "Quando um aliado receberia dano letal, intercepta e recebe [100% / 75% / 50%] do dano no lugar."

msgid "ability.unit_tier3c_soul_summon.name"
msgstr "Invocação de Alma"

msgid "ability.unit_tier3c_soul_summon.desc"
msgstr "Quando esta unidade morre, invoca uma unidade Nível 2 aleatória com [+0 / +2 / +4] de HP e PWR."

msgid "item_t3_a.name"
msgstr "Pedra do Coração"

msgid "item_t3_a.desc"
msgstr "Uma pedra pulsando com vida."

msgid "ability.item_t3a_on_hurt_heal.name"
msgstr "Vínculo Vital"

msgid "ability.item_t3a_on_hurt_heal.desc"
msgstr "Quando o portador é ferido POR UM ATAQUE, cura dois aliados aleatórios em 2 HP cada."

msgid "item_t3_b.name"
msgstr "Amuleto de Poder"

msgid "item_t3_b.desc"
msgstr "Um amuleto antigo de poder."

msgid "ability.item_t3b_on_attack_buff.name"
msgstr "Grito de Guerra"

msgid "ability.item_t3b_on_attack_buff.desc"
msgstr "Quando o portador ataca, concede +2 PWR a dois aliados aleatórios."

msgid "item_t3_c.name"
msgstr "Anel de Roubo de Vida"

msgid "item_t3_c.desc"
msgstr "Um anel que se alimenta dos vivos."

msgid "ability.item_t3c_on_attack_lifesteal.name"
msgstr "Golpe Vampírico"

msgid "ability.item_t3c_on_attack_lifesteal.desc"
msgstr "Ao atacar, cura o portador em 20% do dano causado (mín 1 HP)."

msgid "item_t3_d.name"
msgstr "Espinho Vingativo"

msgid "item_t3_d.desc"
msgstr "Um amuleto espinhoso que revida aqueles que ferem seu portador."

