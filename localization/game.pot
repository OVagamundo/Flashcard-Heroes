msgid "deck.korean_hangul.desc"
msgstr ""

#. English: Ambush Predator
msgid "ability.unit_tier3e_ambush_predator.name"
msgstr ""

#. English: When an enemy unit is summoned, attack it for [50% / 75% / 100%] of this unit's PWR.
msgid "ability.unit_tier3e_ambush_predator.desc"
msgstr ""

#. English: Summon Blessing
msgid "ability.unit_tier3f_summon_blessing.name"
msgstr ""

#. English: When an ally unit is summoned, grant it [+3 / +5 / +7] HP.
msgid "ability.unit_tier3f_summon_blessing.desc"
msgstr ""

#. English: Burn
msgid "STATUS_BURN"
msgstr ""

#. English: Deals damage equal to the amount of stacks at the end of the turn. After dealing damage the value is reduced by half.
msgid "STATUS_BURN_DESC"
msgstr ""

#. English: Armor
msgid "STATUS_ARMOR"
msgstr ""

#. English: Absorbs damage equal to the amount of stacks. Decays completely at the end of the turn.
msgid "STATUS_ARMOR_DESC"
msgstr ""

#. English: Spikes
msgid "STATUS_SPIKES"
msgstr ""

#. English: Deals damage back to the attacker equal to the amount of stacks. Loses 1 stack per activation.
msgid "STATUS_SPIKES_DESC"
msgstr ""

#. English: Static
msgid "STATUS_STATIC"
msgstr ""

#. English: When this unit dies, it deals collateral damage equal to its Static stacks to living adjacent lineup allies, mitigated by Armor. Stacks decay by 1 at the end of each turn.
msgid "STATUS_STATIC_DESC"
msgstr ""

#. English: Royal Insignia
msgid "trinket.royal_insignia.name"
msgstr ""

#. English: A medal signifying royal favor.
msgid "trinket.royal_insignia.desc"
msgstr ""

#. English: Royal Blessing
msgid "ability.royal_insignia.name"
msgstr ""

#. English: When a Level 1 unit enters the board, grant it +1 HP and +1 PWR.
msgid "ability.royal_insignia.desc"
msgstr ""

#. English: Veteran Insignia
msgid "trinket.veteran_insignia.name"
msgstr ""

#. English: A badge of honor for seasoned warriors.
msgid "trinket.veteran_insignia.desc"
msgstr ""

#. English: Veteran Blessing
msgid "ability.veteran_insignia.name"
msgstr ""

#. English: When a Level 2 unit enters the board, grant it +1 HP and +1 PWR.
msgid "ability.veteran_insignia.desc"
msgstr ""

#. English: Fire Trait
msgid "trinket.trait_fire.name"
msgstr ""

#. English: Enables the Fire trait. Fire units ignite enemies on attack, spreading fiery destruction and dealing bonus damage against burning targets.
msgid "trinket.trait_fire.desc"
msgstr ""

#. English: Earth Trait
msgid "trinket.trait_earth.name"
msgstr ""

#. English: Enables the Earth trait. Grants Armor and Spikes across your frontline, turning impenetrable defense into devastating counter-attacks.
msgid "trinket.trait_earth.desc"
msgstr ""

#. English: Water Trait
msgid "trinket.trait_water.name"
msgstr ""

#. English: Enables the Water trait. Flowing waves heal allies, cleanse debilitating negative effects, and convert afflictions into restorative energy.
msgid "trinket.trait_water.desc"
msgstr ""

#. English: Air Trait
msgid "trinket.trait_air.name"
msgstr ""

#. English: Enables the Air trait. Electrifies enemies with Static on attack, splashing charges that detonate into collateral damage upon death.
msgid "trinket.trait_air.desc"
msgstr ""

#. English: Tank Trait
msgid "trinket.trait_tank.name"
msgstr ""

#. English: Enables the Tank trait. Tanks bolster defensive armor, intercept attacks directed at backline allies, and convert armor into punishing spikes.
msgid "trinket.trait_tank.desc"
msgstr ""

#. English: Fighter Trait
msgid "trinket.trait_fighter.name"
msgstr ""

#. English: Enables the Fighter trait. Brawlers excel against high-health targets, cleaving enemies behind their mark and chain-attacking on kill.
msgid "trinket.trait_fighter.desc"
msgstr ""

#. English: Support Trait
msgid "trinket.trait_support.name"
msgstr ""

#. English: Enables the Support trait. Inspires formation allies with bonus health and power, reinforcing the weakest units every turn.
msgid "trinket.trait_support.desc"
msgstr ""

#. English: Specialist Trait
msgid "trinket.trait_specialist.name"
msgstr ""

#. English: Enables the Specialist trait. Manipulates economy and gacha tokens, summoning combat clones and scaling power with accrued gold.
msgid "trinket.trait_specialist.desc"
msgstr ""

#. English: Food Trait
msgid "trinket.trait_food.name"
msgstr ""

#. English: Enables the Food trait. Nourishes the ally standing directly behind when taking hits, passing down full power upon defeat.
msgid "trinket.trait_food.desc"
msgstr ""

#. English: Mecha Trait
msgid "trinket.trait_mecha.name"
msgstr ""

#. English: Enables the Mecha trait. Reinforced with armor and spikes, firing static laser salvos on merges and overloading upon destruction.
msgid "trinket.trait_mecha.desc"
msgstr ""

#. English: Animal Trait
msgid "trinket.trait_animal.name"
msgstr ""

#. English: Enables the Animal trait. Feral pack instincts empower an alpha and heal the pack with every fierce attack.
msgid "trinket.trait_animal.desc"
msgstr ""

#. English: Plant Trait
msgid "trinket.trait_plant.name"
msgstr ""

#. English: Enables the Plant trait. Deep roots foster spikes and steady regeneration, transforming healing into sharp thorn defenses.
msgid "trinket.trait_plant.desc"
msgstr ""

#. English: Toy Trait
msgid "trinket.trait_toy.name"
msgstr ""

#. English: Enables the Toy trait. Generates volatile static friction when struck in melee, culminating in an explosive static detonation on death.
msgid "trinket.trait_toy.desc"
msgstr ""

#. English: Appliance Trait
msgid "trinket.trait_appliance.name"
msgstr ""

#. English: Enables the Appliance trait. Appliances inflict Static and Burn on attack, gain immunity and reflection against both, and convert incoming debuffs into raw stats.
msgid "trinket.trait_appliance.desc"
msgstr ""

#. English: Costume Trait
msgid "trinket.trait_costume.name"
msgstr ""

#. English: Enables the Costume trait. Masquerades in enemy strengths, stealing beneficial status effects and raw attributes before battle begins.
msgid "trinket.trait_costume.desc"
msgstr ""

#. English: Fire
msgid "trait.fire.name"
msgstr ""

#. English: Fire units' attacks inflict 1 Burn stack on target.
msgid "trait.fire.3"
msgstr ""

#. English: ...and inflicts +1 additional Burn if the target already has Burn.
msgid "trait.fire.6"
msgstr ""

#. English: Additionally, when an enemy takes Burn damage at turn end, they spread 1 Burn to each adjacent ally.
msgid "trait.fire.12"
msgstr ""

#. English: ...and Fire units deal bonus attack damage equal to the target's current Burn stacks.
msgid "trait.fire.20"
msgstr ""

#. English: Additionally, when an enemy holding Burn is defeated by a Fire unit, their remaining Burn stacks are distributed between adjacent enemies.
msgid "trait.fire.32"
msgstr ""

#. English: Fire Emblem
msgid "item.emblem_fire.name"
msgstr ""

#. English: When equipped, grants +2 PWR and the [b]Fire[/b] soul, allowing the unit to benefit from Fire trait synergies.
msgid "item.emblem_fire.desc"
msgstr ""

#. English: Earth
msgid "trait.earth.name"
msgstr ""

#. English: Pre-Combat: The frontmost Earth unit gains 1 Armor.
msgid "trait.earth.3"
msgstr ""

#. English: ...and it also gains 1 Spikes.
msgid "trait.earth.6"
msgstr ""

#. English: Adds +1 Armor and +1 Spikes to the effect, and all other Earth units also gain this.
msgid "trait.earth.12"
msgstr ""

#. English: Adds +1 Armor and +1 Spikes to Earth units, and all other allies gain 1 Armor and 1 Spikes.
msgid "trait.earth.20"
msgstr ""

#. English: ...and Earth units deal bonus attack damage equal to their current Spikes (decays 1 Spikes stack per attack instance).
msgid "trait.earth.32"
msgstr ""

#. English: Earth Emblem
msgid "item.emblem_earth.name"
msgstr ""

#. English: When equipped, grants +4 HP and the [b]Earth[/b] soul, allowing the unit to benefit from Earth trait synergies.
msgid "item.emblem_earth.desc"
msgstr ""

#. English: Water
msgid "trait.water.name"
msgstr ""

#. English: Pre-Combat: Water units heal the ally directly in front of them by 1 HP.
msgid "trait.water.3"
msgstr ""

#. English: ...and also cleanse 1 negative status stack (Burn/Static) from that ally.
msgid "trait.water.6"
msgstr ""

#. English: Additionally, at turn start, heals the ally with the lowest HP by 1 HP.
msgid "trait.water.12"
msgstr ""

#. English: Additionally, Pre-Combat: All allies across the team cleanse 1 negative status stack.
msgid "trait.water.20"
msgstr ""

#. English: Additionally, at turn start, allies consume all their negative status stacks to heal 1 HP per stack consumed.
msgid "trait.water.32"
msgstr ""

#. English: Water Emblem
msgid "item.emblem_water.name"
msgstr ""

#. English: When equipped, grants +2 HP, +1 PWR, and the [b]Water[/b] soul, allowing the unit to benefit from Water trait synergies.
msgid "item.emblem_water.desc"
msgstr ""

#. English: Air
msgid "trait.air.name"
msgstr ""

#. English: Air units' attacks inflict 1 Static stack on target.
msgid "trait.air.3"
msgstr ""

#. English: Increases to 2 Static stacks per attack.
msgid "trait.air.6"
msgstr ""

#. English: ...and attacks splash half of the inflicted Static (minimum 1) to adjacent enemies.
msgid "trait.air.12"
msgstr ""

#. English: Additionally, Pre-Combat: Inflicts 1 Static to all enemies.
msgid "trait.air.20"
msgstr ""

#. English: Static inflicted on attack scales to equal the Air unit's PWR (splashes half to adjacent enemies).
msgid "trait.air.32"
msgstr ""

#. English: Air Emblem
msgid "item.emblem_air.name"
msgstr ""

#. English: When equipped, grants +2 HP, +1 PWR, and the [b]Air[/b] soul, allowing the unit to benefit from Air trait synergies.
msgid "item.emblem_air.desc"
msgstr ""

#. English: Tank
msgid "trait.tank.name"
msgstr ""

#. English: Pre-Combat: The frontmost Tank gains 1 Armor.
msgid "trait.tank.2"
msgstr ""

#. English: All Tanks now gain this 1 Armor. Whenever a Tank's Armor absorbs damage, the ally directly behind gains 1 Armor.
msgid "trait.tank.3"
msgstr ""

#. English: Additionally, at turn start, the frontmost Tank gains 1 Armor, and Tanks intercept attacks targeting the ally directly behind them.
msgid "trait.tank.4"
msgstr ""

#. English: ...and whenever a Tank gains Armor from any source, it gains an equal amount of Spikes.
msgid "trait.tank.5"
msgstr ""

#. English: Fighter
msgid "trait.fighter.name"
msgstr ""

#. English: Fighters deal +1 damage on their attacks if the target has more HP than them.
msgid "trait.fighter.2"
msgstr ""

#. English: Additionally, when a Fighter receives attack damage, they retaliate for 1 ranged damage (once per turn).
msgid "trait.fighter.3"
msgstr ""

#. English: Additionally, Fighters' attacks deal half PWR splash damage (minimum 1) to the enemy directly behind their target.
msgid "trait.fighter.4"
msgstr ""

#. English: ...and when a Fighter defeats an enemy, they gain +1 PWR and immediately attack the next enemy (once per turn).
msgid "trait.fighter.5"
msgstr ""

#. English: Support
msgid "trait.support.name"
msgstr ""

#. English: Pre-Combat: Support units grant +1 HP to the ally directly in front of them.
msgid "trait.support.2"
msgstr ""

#. English: ...and also grant +1 PWR to the ally directly behind them.
msgid "trait.support.3"
msgstr ""

#. English: Additionally, at turn start, grants +1 HP to the lowest-HP ally and +1 PWR to the lowest-PWR ally per living Support.
msgid "trait.support.4"
msgstr ""

#. English: Additionally, Pre-Combat: Grants +1 HP and +1 PWR to the Hero unit.
msgid "trait.support.5"
msgstr ""

#. English: Specialist
msgid "trait.specialist.name"
msgstr ""

#. English: Combat Start: If you have 0 tokens remaining, gain 1 Token.
msgid "trait.specialist.2"
msgstr ""

#. English: ...and the first Gacha draw of each battle costs 1 less Token (minimum 1).
msgid "trait.specialist.3"
msgstr ""

#. English: Additionally, defeating an enemy with a Specialist awards +1 Gold (max 1/turn, 5/battle).
msgid "trait.specialist.4"
msgstr ""

#. English: Additionally, summons a combat-only copy of your lowest tier/level unit to bench pre-combat, and at turn start, the frontmost Specialist gains +1 PWR per 5 Gold.
msgid "trait.specialist.5"
msgstr ""

#. English: Food
msgid "trait.food.name"
msgstr ""

#. English: When a Food unit is hurt by an attack, it heals the ally directly behind it by 1 HP.
msgid "trait.food.2"
msgstr ""

#. English: Increases healing to 2 HP.
msgid "trait.food.3"
msgstr ""

#. English: Increases healing to 3 HP, and also grants +1 PWR to that ally.
msgid "trait.food.4"
msgstr ""

#. English: Increases healing to 4 HP and +2 PWR. Additionally, on death, passes all of its current PWR to the ally directly behind it.
msgid "trait.food.5"
msgstr ""

#. English: Mecha
msgid "trait.mecha.name"
msgstr ""

#. English: Pre-Combat: Mecha units gain 1 Spikes.
msgid "trait.mecha.2"
msgstr ""

#. English: ...and also gain 1 Armor. Additionally, Mechas inflict 1 Static on attack and when their Armor absorbs damage.
msgid "trait.mecha.3"
msgstr ""

#. English: Additionally, whenever a merge occurs on the board, each Mecha fires a laser dealing 1 damage and 1 Static to a random enemy.
msgid "trait.mecha.4"
msgstr ""

#. English: Additionally, when a Mecha dies, surviving Mechas gain 2 Armor and 2 Spikes, and fire a laser dealing 2 damage and 2 Static to a random enemy.
msgid "trait.mecha.5"
msgstr ""

#. English: Animal
msgid "trait.animal.name"
msgstr ""

#. English: Pre-Combat: A random Animal gains +1 PWR. Animals heal 1 HP per attack.
msgid "trait.animal.2"
msgstr ""

#. English: Healing per attack increases to 2 HP.
msgid "trait.animal.3"
msgstr ""

#. English: Healing per attack increases to 3 HP.
msgid "trait.animal.4"
msgstr ""

#. English: Healing per attack increases to 3 HP + 25% PWR (minimum +1).
msgid "trait.animal.5"
msgstr ""

#. English: Plant
msgid "trait.plant.name"
msgstr ""

#. English: Pre-Combat: The frontmost Plant unit gains 1 Spikes.
msgid "trait.plant.2"
msgstr ""

#. English: Additionally, at turn start, the lowest-HP Plant recovers 1 HP.
msgid "trait.plant.3"
msgstr ""

#. English: Additionally, Pre-Combat: All Plants gain 1 Spikes and +1 HP (frontmost gains 2 Spikes).
msgid "trait.plant.4"
msgstr ""

#. English: Additionally, at turn start, all Plants gain 1 Spikes and +1 HP. Whenever a Plant receives a heal, it gains 1 Spikes.
msgid "trait.plant.5"
msgstr ""

#. English: Toy
msgid "trait.toy.name"
msgstr ""

#. English: Enemies hitting a Toy with a melee attack receive 2 Static stacks.
msgid "trait.toy.2"
msgstr ""

#. English: Increases to 3 Static stacks.
msgid "trait.toy.3"
msgstr ""

#. English: Increases to 4 Static stacks.
msgid "trait.toy.4"
msgstr ""

#. English: Additionally, on death, detonates all Static on the enemy holding the highest Static stacks, dealing damage equal to those stacks to it and clearing them.
msgid "trait.toy.5"
msgstr ""

#. English: Appliance
msgid "trait.appliance.name"
msgstr ""

#. English: Appliance units inflict 1 Static on attack. Appliances are immune to Static and remove held Static pre-combat.
msgid "trait.appliance.2"
msgstr ""

#. English: ...and also inflict 1 Burn on attack. Appliances become immune to Burn and cleanse held Burn pre-combat.
msgid "trait.appliance.3"
msgstr ""

#. English: Additionally, when an enemy attempts to apply Static or Burn to an Appliance, it is reflected back to the sender.
msgid "trait.appliance.4"
msgstr ""

#. English: Additionally, incoming negative status attempts grant stats: each attempted Static grants +1 PWR, and each attempted Burn grants +1 HP.
msgid "trait.appliance.5"
msgstr ""

#. English: Costume
msgid "trait.costume.name"
msgstr ""

#. English: Pre-Combat: Steals 1 stack of the mirror enemy's highest beneficial status effect, or 1 point of their highest stat.
msgid "trait.costume.2"
msgstr ""

#. English: Instead of above, Pre-Combat: Steals the entire highest beneficial status effect from the mirror enemy, or 1 HP and 1 PWR.
msgid "trait.costume.3"
msgstr ""

#. English: Upgrades to steal all beneficial status effects from the mirror enemy, or 2 HP and 2 PWR.
msgid "trait.costume.4"
msgstr ""

#. English: Pre-Combat: Executed once for the team. The Hero steals all Armor and Spikes, plus 3 HP and 3 PWR, from the enemy with highest total Armor and Spikes.
msgid "trait.costume.5"
msgstr ""

#. English: Minor Healing Potion
msgid "item.potion_t1.name"
msgstr ""

#. English: Restores 4 HP to a target unit.
msgid "item.potion_t1.desc"
msgstr ""

#. English: Drink
msgid "ability.potion_t1.name"
msgstr ""

#. English: Restores 4 HP.
msgid "ability.potion_t1.desc"
msgstr ""

#. English: Thorn Potion
msgid "item.potion_spikes.name"
msgstr ""

#. English: Grants 4 Spikes to target. Spikes damage attackers then lose a stack.
msgid "item.potion_spikes.desc"
msgstr ""

#. English: Thorn Skin
msgid "ability.grant_spikes.name"
msgstr ""

#. English: Grants 4 Spikes stacks
msgid "ability.grant_spikes.desc"
msgstr ""

#. English: Heroism Potion
msgid "item.potion_heroism.name"
msgstr ""

#. English: A potion that inspires heroism.
msgid "item.potion_heroism.desc"
msgstr ""

#. English: Heroism
msgid "ability.grant_heroism.name"
msgstr ""

#. English: Grants +3 HP, +3 PWR, and 3 Armor stacks.
msgid "ability.grant_heroism.desc"
msgstr ""

#. English: Potion of Plunder
msgid "item.potion_plunder.name"
msgstr ""

#. English: Steals a random item from the target and sends it to your Gacha Machine of the matching tier.
msgid "item.potion_plunder.desc"
msgstr ""

#. English: Plunder
msgid "ability.potion_plunder.name"
msgstr ""

#. English: Steals a random item from the target and sends it to your Gacha Machine of the matching tier.
msgid "ability.potion_plunder.desc"
msgstr ""

#. English: Mirror Image
msgid "ability.unit_t2_e_mimic.name"
msgstr ""

#. English: At start of turn, transforms into the base unit of the mirror enemy, gaining [+0 / +2 / +4] HP and PWR.
msgid "ability.unit_t2_e_mimic.desc"
msgstr ""

#. English: Buff Echo
msgid "ability.unit_t2_g_buff_echo.name"
msgstr ""

#. English: When an adjacent ally receives a HP or PWR buff, this unit repeats [100% / 150% / 200%] of that buff on them.
msgid "ability.unit_t2_g_buff_echo.desc"
msgstr ""

#. English: Solitary Strength
msgid "ability.unit_t2_h.name"
msgstr ""

#. English: At start of combat, gain +1 HP and +1 PWR for each empty slot in your team.
msgid "ability.unit_t2_h_l1.desc"
msgstr ""

#. English: At start of combat, gain +2 HP and +2 PWR for each empty slot in your team.
msgid "ability.unit_t2_h_l2.desc"
msgstr ""

#. English: At start of combat, gain +3 HP and +3 PWR for each empty slot in your team.
msgid "ability.unit_t2_h_l3.desc"
msgstr ""

#. English: Mud Coating
msgid "ability.mud_coating.name"
msgstr ""

#. English: When healed, gain 1 Armor and 1 Spikes.
