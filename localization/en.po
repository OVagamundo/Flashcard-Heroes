msgid "GLOSSARY_ATTACK_OVERRIDE"
msgstr "Attack Override"

msgid "GLOSSARY_ATTACK_OVERRIDE_DESC"
msgstr "Replaces standard attack delivery with a specialized ability or damage pattern."

msgid "GLOSSARY_BOUNCE"
msgstr "Bounce"

msgid "GLOSSARY_BOUNCE_DESC"
msgstr "Strikes the primary target and then jumps to additional random enemies, halving damage or stacks per bounce."

msgid "GLOSSARY_EMPOWERED_ATTACK"
msgstr "Empowered Attack"

msgid "GLOSSARY_EMPOWERED_ATTACK_DESC"
msgstr "An enhanced attack action that expends upon execution to deal Bonus Damage or apply Effects to the target."

msgid "GLOSSARY_EXTRA_ACTION"
msgstr "Extra Action"

msgid "GLOSSARY_EXTRA_ACTION_DESC"
msgstr "Acts again immediately with a full turn action, re-evaluating all abilities (once per turn)."

msgid "GLOSSARY_EXTRA_ATTACK"
msgstr "Extra Attack"

msgid "GLOSSARY_EXTRA_ATTACK_DESC"
msgstr "Performs an immediate additional attack action during this turn (once per turn)."

msgid "GLOSSARY_INTERCEPT"
msgstr "Intercept"

msgid "GLOSSARY_INTERCEPT_DESC"
msgstr "Leaps in front of an ally to absorb an incoming attack in their place."

msgid "GLOSSARY_LIFESTEAL"
msgstr "Lifesteal"

msgid "GLOSSARY_LIFESTEAL_DESC"
msgstr "Heals the attacker for a percentage of actual HP damage dealt to the target."

msgid "GLOSSARY_MELEE"
msgstr "Melee Attack"

msgid "GLOSSARY_MELEE_DESC"
msgstr "Strikes the frontmost enemy. Mitigated by ARMOR; triggers defender SPIKES."

msgid "GLOSSARY_RANGED"
msgstr "Ranged Attack"

msgid "GLOSSARY_RANGED_DESC"
msgstr "Strikes the enemy in the mirror slot. If that slot is empty, targets the backmost enemy. Mitigated by ARMOR; bypasses defender SPIKES."

msgid "GLOSSARY_SHOCKWAVE"
msgstr "Shockwave"

msgid "GLOSSARY_SHOCKWAVE_DESC"
msgstr "Strikes the primary target and spills damage into up to 2 slots behind with 50% falloff per slot."

msgid "STATUS_ARMOR"
msgstr "Armor"

msgid "STATUS_ARMOR_DESC"
msgstr "Absorbs damage equal to the amount of stacks. Decays completely at the end of the turn."

msgid "STATUS_BOUNTY"
msgstr "Bounty"

msgid "STATUS_BOUNTY_DESC"
msgstr "When this unit is defeated by any means, awards 1 Gold. Stays until this unit dies or the battle ends."

msgid "STATUS_BURN"
msgstr "Burn"

msgid "STATUS_BURN_DESC"
msgstr "Deals damage equal to the amount of stacks at the end of the turn. After dealing damage the value is reduced by half."

msgid "STATUS_REINFORCE"
msgstr "Reinforce"

msgid "STATUS_REINFORCE_DESC"
msgstr "Prevents ARMOR from decaying at turn start. Loses 1 stack at turn start."

msgid "STATUS_SPIKES"
msgstr "Spikes"

msgid "STATUS_SPIKES_DESC"
msgstr "Deals damage back to the attacker equal to the amount of stacks. Loses 1 stack per activation."

msgid "STATUS_STATIC"
msgstr "Static"

msgid "STATUS_STATIC_DESC"
msgstr "When this unit dies, it deals collateral damage equal to its Static stacks to living adjacent lineup allies, mitigated by Armor. Stacks decay by 1 at the end of each turn."

