msgid "hero.name"
msgstr "Bounty Hunter"

msgid "hero.desc"
msgstr "A skilled hunter who profits from every kill and grows stronger from loss. Earns gold for each enemy slain, and gains +1 HP and +1 PWR when allies fall."

msgid "enemy_hero.name"
msgstr "Enemy Hero"

msgid "enemy_hero.desc"
msgstr "The enemy's champion."

msgid "unit_t1_a.name"
msgstr "Rocky"

msgid "unit_t1_a.desc"
msgstr "Novice unit."

msgid "unit_t1_b.name"
msgstr "Burny"

msgid "unit_t1_b.desc"
msgstr "Loyal squire."

msgid "unit_t2_d.name"
msgstr "Templar"

msgid "unit_t2_d.desc"
msgstr "A devout templar."

msgid "ability.unit_t2_d_power.name"
msgstr "Token Power"

msgid "ability.unit_t2_d_power_l1.desc"
msgstr "Gains extra PWR equal to 100% of current Tokens, updating whenever Tokens change."

msgid "ability.unit_t2_d_power_l2.desc"
msgstr "Gains extra PWR equal to 150% of current Tokens, updating whenever Tokens change."

msgid "ability.unit_t2_d_power_l3.desc"
msgstr "Gains extra PWR equal to 200% of current Tokens, updating whenever Tokens change."

msgid "unit_t2_f.name"
msgstr "Merchant"

msgid "unit_t2_f.desc"
msgstr "Traveling merchant."

msgid "ability.unit_t2_f_gold_pwr.name"
msgstr "Gold Investments"

msgid "ability.unit_t2_f_gold_pwr_l1.desc"
msgstr "Initial PWR equals your current Gold multiplied by 50% when drawn or spawned."

msgid "ability.unit_t2_f_gold_pwr_l2.desc"
msgstr "Initial PWR equals your current Gold multiplied by 100% when drawn or spawned."

msgid "ability.unit_t2_f_gold_pwr_l3.desc"
msgstr "Initial PWR equals your current Gold multiplied by 150% when drawn or spawned."

msgid "unit_t1_c.name"
msgstr "Dewey"

msgid "unit_t1_c.desc"
msgstr "Steadfast guardian."

msgid "ability.unit_t1_c_ally_shield.name"
msgstr "Guardian's Grace"

msgid "ability.unit_t1_c_ally_shield.desc"
msgstr "When the ally directly in front takes damage, heal them for 1 HP."

msgid "ability.unit_t1_c_ally_shield_l2.desc"
msgstr "When the ally directly in front takes damage, heal them for 2 HP."

msgid "ability.unit_t1_c_ally_shield_l3.desc"
msgstr "When the ally directly in front takes damage, heal them for 3 HP."

msgid "unit_t1_d.name"
msgstr "Windy"

msgid "unit_t1_d.desc"
msgstr "Sensitive soul."

msgid "ability.unit_t1_d_empathic_link.name"
msgstr "Empathic Link"

msgid "ability.unit_t1_d_empathic_link.desc"
msgstr "When this unit dies, grant its current PWR to the ally behind."

msgid "ability.unit_t1_d_empathic_link_l2.desc"
msgstr "When this unit dies, grant its current PWR to the ally behind, and half of that to the next ally."

msgid "ability.unit_t1_d_empathic_link_l3.desc"
msgstr "When this unit dies, grant its current PWR to the ally behind, half to the next, and half to the next."

msgid "ability.unit_tier1a_passive_heal.name"
msgstr "Resilience"

msgid "ability.unit_tier1a_passive_heal.desc"
msgstr "When hurt BY AN ATTACK, Heal this unit by 1 HP."

msgid "ability.unit_tier1a_passive_heal_l2.desc"
msgstr "When hurt BY AN ATTACK, Heal this unit by 2 HP."

msgid "ability.unit_tier1a_passive_heal_l3.desc"
msgstr "When hurt BY AN ATTACK, Heal this unit by 3 HP."

msgid "ability.unit_tier1b_counter_on_hurt.name"
msgstr "Retaliation"

msgid "ability.unit_tier1b_counter_on_hurt.desc"
msgstr "When hurt BY AN ATTACK, shoot a projectile at the attacker dealing damage equal to PWR. Triggers even if lethal."

msgid "ability.unit_tier1b_counter_on_hurt_l2.desc"
msgstr "When hurt BY AN ATTACK, shoot a projectile at the attacker dealing damage equal to PWR. The projectile then bounces to another random enemy, dealing half damage."

msgid "ability.unit_tier1b_counter_on_hurt_l3.desc"
msgstr "When hurt BY AN ATTACK, shoot a projectile at the attacker dealing damage equal to PWR. The projectile then bounces to 2 random enemies, dealing half damage per bounce."

msgid "unit_t2_c.name"
msgstr "Knight"

msgid "unit_t2_c.desc"
msgstr "Valiant knight."

msgid "item_t1_a.name"
msgstr "Koi's Blessing"

msgid "item_t1_a.desc"
msgstr "A gentle remedy infused with the spirit of koi."

msgid "item_t1_b.name"
msgstr "Tiger's Spirit"

msgid "item_t1_b.desc"
msgstr "A fierce elixir that awakens inner strength."

msgid "item_t2_c.name"
msgstr "Phoenix Elixir"

msgid "item_t2_c.desc"
msgstr "A restorative brew that renews body and spirit."

msgid "ability.basic_attack.name"
msgstr "Basic Attack"

msgid "ability.basic_attack.desc"
msgstr "Deal (PWR) damage to the frontmost enemy."

msgid "ability.basic_attack_ranged_mirror.name"
msgstr "Basic Attack"

msgid "ability.basic_attack_ranged_mirror.desc"
msgstr "Deal (PWR) damage to the enemy in the mirror slot."

msgid "ability.item_tier1b_extra_attack.name"
msgstr "Extra Attack"

msgid "ability.item_tier1b_extra_attack.desc"
msgstr "When attacking, if target has more HP than holder then perform an extra attack."

msgid "item.effect.hp"
msgstr "Add (HP) HP to the unit."

msgid "item.effect.pwr"
msgstr "Add (PWR) PWR to the unit."

msgid "item.effect.both"
msgstr "Add (HP) HP and (PWR) PWR to the unit."

msgid "trinket.polished_plate.name"
msgstr "Polished Plate"

msgid "trinket.polished_plate.desc"
msgstr "A perfectly polished piece of armor."

msgid "ability.polished_plate.name"
msgstr "Reinforced Armor"

msgid "ability.polished_plate.desc"
msgstr "At the start of the turn, gain 2 Armor."

