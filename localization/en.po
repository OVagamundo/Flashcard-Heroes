msgstr "Regeneration"

msgid "ability.item_tier2c_passive_heal.desc"
msgstr "When hurt BY AN ATTACK, Heal this unit by 1 HP and gain 1 PWR."

msgid "ability.item_tier1a_turn_start_heal.name"
msgstr "Restoration"

msgid "ability.item_tier1a_turn_start_heal.desc"
msgstr "At the start of the turn, Heal the holder for 2 HP."

msgid "ability.unit_tier2c_ally_death_buff.name"
msgstr "Morale Boost"

msgid "ability.unit_tier2c_ally_death_buff_l1.desc"
msgstr "When an ally is defeated, gain +1 HP and +1 PWR."

msgid "ability.unit_tier2c_ally_death_buff_l2.desc"
msgstr "When an ally is defeated, gain +2 HP and +1 PWR."

msgid "ability.unit_tier2c_ally_death_buff_l3.desc"
msgstr "When an ally is defeated, gain +2 HP and +2 PWR."

msgid "ability.hero_bounty_hunter_ally_death_buff.name"
msgstr "Scavenger's Resolve"

msgid "ability.hero_bounty_hunter_ally_death_buff.desc"
msgstr "When an ally is defeated, gain +1 HP and +1 PWR."

msgid "ability.item_tier3d_retaliate.name"
msgstr "Retaliation"

msgid "ability.item_tier3d_retaliate.desc"
msgstr "When hurt BY AN ATTACK, deal half of the holder's PWR as damage to a random enemy."

msgid "ability.unit_tier3d_resilient_aura.name"
msgstr "Resilient Aura"

msgid "ability.unit_tier3d_resilient_aura.desc"
msgstr "When hurt BY AN ATTACK, grants +1 HP and +1 PWR to adjacent allies."

msgid "item_t2_a.name"
msgstr "Summoning Scroll"

msgid "item_t2_a.desc"
msgstr "A scroll containing a summoning spell."

msgid "item_t3_e.name"
msgstr "Death's Bargain"

msgid "item_t3_e.desc"
msgstr "A cursed bargain with death."

msgid "item_t3_f.name"
msgstr "Soul Siphon"

msgid "item_t3_f.desc"
msgstr "A dark siphon of souls."

msgid "item_t3_g.name"
msgstr "Sniper Aim"

msgid "item_t3_g.desc"
msgstr "A scope for precise targeting."

msgid "ability.item_t3e_death_damage.name"
msgstr "Final Strike"

msgid "ability.item_t3f_power_drain.name"
msgstr "Power Drain"

msgid "ability.item_t3f_power_drain.desc"
msgstr "After dealing damage steal half of target's PWR (min 1)."

msgid "ability.item_t3e_death_damage.desc"
msgstr "When the holder dies deal damage equal to half of the highest HP enemy's HP to that enemy."

msgid "ability.item_t2_c_summon.name"
msgstr "Summon"

msgid "ability.item_t2_c_summon.desc"
msgstr "When the holder dies, summon a random Tier 1 unit in their place."

msgid "unit_t3_paladin.name"
msgstr "Paladin"

msgid "unit_t3_paladin.desc"
msgstr "Heavily armored tank."

msgid "unit_t3_berserker.name"
msgstr "Berserker"

msgid "unit_t3_berserker.desc"
msgstr "Powerful warrior."

msgid "ability.unit_tier2a_defensive_stance.name"
msgstr "Defensive Stance"

msgid "ability.unit_tier2a_defensive_stance.desc"
msgstr "When targeted by an attack, heal [2 / 4 / 6] HP before taking damage."

msgid "ability.unit_tier2b_shockwave.name"
msgstr "Shockwave"

msgid "ability.unit_tier2b_shockwave.desc"
msgstr "Attack deals cascading damage: [100% / 150% / 200%] to front, 50% to the unit behind, 25% to the one behind that."

msgid "item_t2_b.name"
msgstr "Bloodlust Edge"

msgid "item_t2_b.desc"
msgstr "A blade thirsty for blood."

msgid "ability.item_tier2b_bloodlust.name"
msgstr "Bloodlust"

msgid "ability.item_tier2b_bloodlust.desc"
msgstr "When the holder defeats an enemy, they act again immediately."

msgid "hero_timekeeper.name"
msgstr "Timekeeper"

msgid "hero_timekeeper.desc"
msgstr "A scholarly mage who grants +2 HP to units in front and +2 PWR to units behind at turn start. Masters time to extend the minigame timer."

msgid "ability.hero_timekeeper_gold_on_kill.name"
msgstr "Bounty Hunter"

msgid "ability.hero_timekeeper_gold_on_kill.desc"
msgstr "Gain 1 gold when this hero kills an enemy."

msgid "ability.hero_timekeeper_time_warp.name"
msgstr "Time Warp"

msgid "ability.hero_timekeeper_time_warp.desc"
msgstr "Minigame: +1s correct, -0.5s wrong. Gains 5 tokens per turn in Battle and Rest Sites."

msgid "ability.hero_timekeeper_temporal_aura.name"
msgstr "Temporal Aura"

msgid "ability.hero_timekeeper_temporal_aura.desc"
msgstr "At the start of each turn, grants +2 HP to units in front and +2 PWR to units behind."

msgid "unit_t3_d.name"
msgstr "Sakura Spirit"

msgid "unit_t3_d.desc"
msgstr "A powerful spirit guarding the cherry blossoms."

msgid "boss_1.name"
msgstr "The Awakened Guardian"

msgid "boss_1.desc"
msgstr "A powerful guardian that summons allies and grows stronger as you draw from the gacha machines."

msgid "boss_2.name"
msgstr "The Shadow Warden"

msgid "boss_2.desc"
msgstr "Drains power from every token you spend. Calls upon shadow creatures to fight alongside it."

msgid "boss_3.name"
msgstr "The Storm Herald"

msgid "boss_3.desc"
msgstr "Grows stronger as allies fall around it. Commands reinforcements to join its ranks."

msgid "boss_4.name"
msgstr "The Ancient Titan"

msgid "boss_4.desc"
msgstr "An ancient being that summons warriors from ages past."

msgid "boss_5.name"
msgstr "The Final Arbiter"

msgid "boss_5.desc"
msgstr "The ultimate challenge. Defeat it to complete your run."

msgid "ability.boss_summon.name"
msgstr "Call Reinforcements"

msgid "ability.boss_summon.desc"
msgstr "At end of turn, summon units to fill empty team slots."

msgid "ability.boss_1_draw_drain.name"
msgstr "Draining Presence"

msgid "ability.boss_1_draw_drain.desc"
msgstr "Every time you draw a gachaball, this boss gains +1 HP."

msgid "ability.boss_2_token_drain.name"
msgstr "Token Hunger"

msgid "ability.boss_2_token_drain.desc"
msgstr "Every time you spend a token, this boss gains +1 HP."

msgid "ability.boss_3_ally_growth.name"
msgstr "Vengeance Growth"

msgid "ability.boss_3_ally_growth.desc"
msgstr "When an ally is defeated, gain +1 HP and +1 PWR."

msgid "trinket.soul_echo.name"
msgstr "Soul Echo"

msgid "trinket.soul_echo.desc"
msgstr "A mystical gem that echoes the souls of the fallen."

msgid "ability.soul_echo.name"
msgstr "Soul Echo"

msgid "ability.soul_echo.desc"
msgstr "When an ally dies, resurrect the first non-hero unit that died this turn."

msgid "trinket.vengeance.name"
msgstr "Vengeance Charm"

msgid "trinket.vengeance.desc"
msgstr "Channel the fury of fallen allies."

msgid "ability.vengeance.name"
msgstr "Vengeance"

msgid "ability.vengeance.desc"
msgstr "When an ally dies, grant +1 HP and +1 PWR to a random ally."

msgid "trinket.aegis.name"
msgstr "Aegis Charm"

msgid "trinket.aegis.desc"
msgstr "A protective charm that shields allies from fatal blows."

msgid "ability.aegis.name"
msgstr "Last Stand"

msgid "ability.aegis.desc"
msgstr "Once per turn: When an ally would die, they survive with 1 HP instead."

msgid "trinket.twin_charm.name"
msgstr "Twin Charm"

msgid "trinket.twin_charm.desc"
msgstr "A mirrored charm that reflects its surroundings."

msgid "ability.twin_charm_scale.name"
msgstr "Shared Reflection"

msgid "ability.twin_charm_scale.desc"
msgstr "Your units gain +1 PWR for every 2 copies of that same unit in your battle pool."

msgid "unit_t3_a.name"
msgstr "Shadow Striker"

msgid "unit_t3_a.desc"
msgstr "Master of precise strikes."

msgid "ability.unit_tier3a_mirror_strike.name"
msgstr "Mirror Strike"

msgid "ability.unit_tier3a_mirror_strike.desc"
msgstr "Attacks the enemy in the opposite slot, dealing [100% / 150% / 200%] damage. If empty, attacks the backmost enemy."

msgid "unit_t3_b.name"
msgstr "Guardian Sentinel"

msgid "unit_t3_b.desc"
msgstr "Stalwart protector."

msgid "ability.unit_tier3b_guardian_sacrifice.name"
msgstr "Guardian Sacrifice"

msgid "ability.unit_tier3b_guardian_sacrifice.desc"
msgstr "When an ally would take lethal damage, intercepts and takes [100% / 75% / 50%] of that damage instead."

msgid "unit_t3_c.name"
msgstr "Soul Caller"

msgid "unit_t3_c.desc"
msgstr "Mystical unit."

msgid "ability.unit_tier3c_soul_summon.name"
msgstr "Soul Summon"

msgid "ability.unit_tier3c_soul_summon.desc"
msgstr "When this unit dies, summon a random Tier 2 unit with [+0 / +2 / +4] HP and PWR."

msgid "item_t3_a.name"
msgstr "Heart Stone"

msgid "item_t3_a.desc"
msgstr "A stone pulsating with life."

msgid "ability.item_t3a_on_hurt_heal.name"
msgstr "Vital Link"

msgid "ability.item_t3a_on_hurt_heal.desc"
msgstr "When the holder is hurt BY AN ATTACK, heal two random allies for 2 HP each."

msgid "item_t3_b.name"
msgstr "Power Amulet"

msgid "item_t3_b.desc"
msgstr "An ancient amulet of power."

msgid "ability.item_t3b_on_attack_buff.name"
msgstr "Battle Cry"

msgid "ability.item_t3b_on_attack_buff.desc"
msgstr "When the holder attacks, grant +2 PWR to two random allies."

msgid "item_t3_c.name"
msgstr "Lifesteal Ring"

msgid "item_t3_c.desc"
msgstr "A ring that feeds on the living."

msgid "ability.item_t3c_on_attack_lifesteal.name"
msgstr "Vampiric Strike"

msgid "ability.item_t3c_on_attack_lifesteal.desc"
msgstr "On attack, heal the holder for 20% of damage dealt (min 1 HP)."

msgid "item_t3_d.name"
msgstr "Vengeful Thorn"

msgid "item_t3_d.desc"
msgstr "A thorny charm that strikes back at those who harm its bearer."

