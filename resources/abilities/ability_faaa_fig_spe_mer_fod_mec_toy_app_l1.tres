[gd_resource type="Resource" script_class="AbilityDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/AbilityDefinition.gd" id="1_ability"]
[ext_resource type="Resource" path="res://resources/conditions/condition_min_gold_10.tres" id="2_cond"]
[ext_resource type="Script" path="res://scripts/effects/EffectSpendGold.gd" id="3_spend"]
[ext_resource type="Script" path="res://scripts/EffectApplyStatus.gd" id="4_status"]

[sub_resource type="Resource" id="Effect_Spend"]
script = ExtResource("3_spend")
parameters = {
"amount": 1
}
target_type = &"SELF"

[sub_resource type="Resource" id="Effect_Burn_1"]
script = ExtResource("4_status")
parameters = {
"amount": {
"base_value": 1,
"context_multiplier_key": "gold_tens"
},
"status_id": "burn"
}
target_type = &"ATTACK_TARGET"

[resource]
script = ExtResource("1_ability")
id = &"ability_faaa_fig_spe_mer_fod_mec_toy_app_l1"
description_key = "ability.eefa_fig_spe_mer_fod_mec_toy_app.l1.desc"
trigger = &"when_attacking"
condition = ExtResource("2_cond")
effects = Array[Resource]([SubResource("Effect_Spend"), SubResource("Effect_Burn_1")])
sub_phase = 200
max_level = 1
replaces_basic_attack = false
