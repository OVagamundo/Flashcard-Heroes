[gd_resource type="Resource" script_class="AbilityDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/AbilityDefinition.gd" id="1_ability"]
[ext_resource type="Script" path="res://scripts/effects/EffectChargeEmpoweredAttack.gd" id="2_effect"]

[sub_resource type="Resource" id="Effect_EFNovApp"]
script = ExtResource("2_effect")
parameters = {
"mode": "SPEND_1_BURN_PER_TOKEN_HELD"
}
target_type = &"SELF"

[resource]
script = ExtResource("1_ability")
id = &"ability_ef_nov_app"
description_key = "EF??NovApp.desc"
trigger = &"when_attacking"
effects = Array[Resource]([SubResource("Effect_EFNovApp")])
sub_phase = 100
max_level = 3
